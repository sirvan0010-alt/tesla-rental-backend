# Comgate merchant credentials (test=true uses the sandbox gateway)
COMGATE_MERCHANT_ID=123456
COMGATE_SECRET=change-me
COMGATE_TEST=true

# Where Comgate should redirect the customer after paying / after the bank step
FRONTEND_RETURN_URL=https://vase-domena.cz/rezervace/hotovo
# Where Comgate calls back to confirm payment/pre-auth status (must be public HTTPS)
BACKEND_CALLBACK_URL=https://api.vase-domena.cz/api/payment/webhook

PORT=3000

# PostgreSQL connection pro Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/tesla_rental

# Poskytovatel dočasného přístupu k vozu (FleetBold partner API nebo obdoba)
VEHICLE_ACCESS_API_URL=https://api.fleetbold.com
VEHICLE_ACCESS_API_KEY=change-me

# Klíč pro přístup k dokladům zákazníků (admin.html, /api/documents/:id/view)
# Vygenerujte si silný náhodný řetězec, nenechávejte "change-me" v produkci.
ADMIN_API_KEY=change-me
