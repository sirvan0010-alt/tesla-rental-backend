# --- MOCK režim (bez registrace) ---
# true = žádné volání Comgate/FleetBold, celý tok jde otestovat lokálně
MOCK_MODE=true

# Comgate (produkce/sandbox — až budete mít účet, MOCK_MODE=false)
COMGATE_MERCHANT_ID=123456
COMGATE_SECRET=change-me
COMGATE_TEST=true

FRONTEND_RETURN_URL=http://localhost:3000/
BACKEND_CALLBACK_URL=http://localhost:3000/api/payment/webhook

PORT=3000

# PostgreSQL (docker compose up -d → tyto hodnoty)
DATABASE_URL=postgresql://tesla:tesla@localhost:5432/tesla_rental

# FleetBold / přístup k vozu (až budete mít klíč, MOCK_MODE=false)
VEHICLE_ACCESS_API_URL=https://api.fleetbold.com
VEHICLE_ACCESS_API_KEY=change-me

# Admin klíč pro admin.html a /api/documents
ADMIN_API_KEY=dev-admin-key-change-in-production
