datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReservationStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  ACTIVE
  RETURNED
  SETTLED
  FAILED
  CANCELLED
}

model Vehicle {
  id               String   @id @default(cuid())
  vin              String   @unique
  name             String
  active           Boolean  @default(true)
  dailyPriceCzk    Int
  kauceAmountCzk   Int
  createdAt        DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerName  String
  customerEmail String
  customerPhone String

  driverLicensePhotoUrl String?
  idCardPhotoUrl        String?

  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleVin String
  startsAt   DateTime
  endsAt     DateTime

  depositAmountCzk Int
  kauceAmountCzk   Int

  status ReservationStatus @default(DRAFT)

  depositTransId String?
  kauceTransId   String?

  vehicleAccessId    String?
  vehicleUnlockUrl   String?
  vehicleAccessError String?

  returnPhotosUrls String[]
  damageNoteText   String?

  @@index([status])
  @@index([customerEmail])
  @@index([vehicleId, startsAt, endsAt])
}
